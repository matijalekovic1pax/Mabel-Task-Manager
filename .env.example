# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Local MCP server only. Never expose this key in browser code.
# Use the service-role key for trusted local MCP clients so the server can read
# tasks/todos, then scope responses to one active profile below.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
TASK_MANAGER_MCP_PROFILE_EMAIL=you@example.com
# TASK_MANAGER_MCP_PROFILE_ID=00000000-0000-0000-0000-000000000000
